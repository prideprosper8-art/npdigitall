# NP Digital - Environment Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8787

# Data Storage
# Directory where inquiries will be saved
NP_DATA_DIR=.data

# WhatsApp Notifications
# Your WhatsApp number (with country code, no + or spaces)
# Example for India: 918866595666
NP_WHATSAPP_NUMBER=918866595666

# Option 1: CallMeBot API (Free, Simple Setup)
# Get your API key from: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Steps:
# 1. Add phone number +34 644 35 80 65 to your contacts (save as "CallMeBot")
# 2. Send "I allow callmebot to send me messages" to this number
# 3. You'll receive your API key
NP_WHATSAPP_API_KEY=your_callmebot_api_key_here

# Option 2: WhatsApp Webhook (Advanced - Requires Setup)
# Use services like Twilio, WhatsApp Business API, or automation tools
NP_WHATSAPP_WEBHOOK_URL=https://your-whatsapp-webhook.com/send

# CRM Integration (Optional)
# Generic webhook for CRM systems (HubSpot, Zapier, Make.com, etc.)
NP_CRM_WEBHOOK_URL=https://your-crm-webhook-url.com/endpoint

# Email Notifications (Coming Soon)
# NP_SMTP_HOST=smtp.gmail.com
# NP_SMTP_PORT=587
# NP_SMTP_USER=your-email@gmail.com
# NP_SMTP_PASS=your-app-password
# NP_NOTIFY_EMAIL=npdigitalinfo@gmail.com
