{
  "name": "np-digital-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare:images && npm run images:services && vite build && npm run typecheck",
    "preview": "vite preview",
    "serve": "node dist-server/index.js",
    "server:build": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "prepare:images": "node scripts/prepare-images.mjs",
    "images:services": "node scripts/make-service-images.mjs",
    "start": "cross-env NODE_ENV=production node dist-server/index.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  }
}
